#!/usr/bin/env bash
# R1.5: pre-action oracle causal intervention for the frozen scalar V3 selector.
set -Eeuo pipefail

set +u
PS1="${PS1:-selector-oracle-r15}"
. /inspire/hdd/project/roboticsystem2/wangcaojun-240208020180/dotfiles/.bashrc
set -u

MODE="${1:-}"
RUN_ID="${2:-r15_$(date -u +%Y%m%dT%H%M%SZ)}"
case "${MODE}" in
    preflight|baseline|interventions|analyze|all) ;;
    *)
        echo "Usage: $0 {preflight|baseline|interventions|analyze|all} [RUN_ID]" >&2
        exit 2
        ;;
esac
[[ "${RUN_ID}" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Invalid run id: ${RUN_ID}" >&2; exit 2; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WORLDENGINE_ROOT="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"
export SOURCE_WORLDENGINE_ROOT="${SELECTOR_R15_SOURCE_WORLDENGINE_ROOT:-/inspire/hdd/global_user/wangcaojun-240208020180/nry/WorldEngine}"
export SIMENGINE_ROOT="${WORLDENGINE_ROOT}/projects/SimEngine"
export ALGENGINE_ROOT="${WORLDENGINE_ROOT}/projects/AlgEngine"
export ALGENGINE_ENV="${DIFFUSIONDRIVE_ALGENGINE_ENV_OVERRIDE:-/inspire/hdd/global_user/wangcaojun-240208020180/miniconda3/envs/algengine}"
export ALGENGINE_PYTHON="${ALGENGINE_ENV}/bin/python"
export SIMENGINE_PYTHON="${DIFFUSIONDRIVE_SIMENGINE_PYTHON:-/root/miniconda3/envs/simengine/bin/python}"
export PATH="${ALGENGINE_ENV}/bin:${PATH}"
export DIFFUSIONDRIVE_ROOT=/inspire/hdd/global_user/wangcaojun-240208020180/nry/DiffusionDrive
export MMCV_ROOT=/inspire/hdd/global_user/wangcaojun-240208020180/nry/mmcv
export NUPLAN_DEVKIT_ROOT=/inspire/hdd/project/roboticsystem2/wangcaojun-240208020180/repo-wcj/nuplan-devkit
export SENIOR_NAVSIM_PARENT=/inspire/hdd/project/roboticsystem2/wangcaojun-240208020180/repo-wcj/E2E/navsim_v1
export H100_SUPPORT_DIR="${SIMENGINE_ROOT}/scripts/diffusiondrive"
export DIFFUSIONDRIVE_BOOTSTRAP="${H100_SUPPORT_DIR}/algengine_worker_bootstrap"
export WORLDENGINE_DIFFUSIONDRIVE_MMCV_BOOTSTRAP=1
export WORLDENGINE_DIFFUSIONDRIVE_GSPLAT_BOOTSTRAP=1
export WORLDENGINE_MMCV_EXTENSION="${SOURCE_WORLDENGINE_ROOT}/artifacts/toolchains/mmcv_sm89_sm90_v1/mmcv/_ext.so"
export WORLDENGINE_GSPLAT_EXTENSION="${SOURCE_WORLDENGINE_ROOT}/artifacts/toolchains/gsplat_sm89_sm90_v1/gsplat/csrc.so"
export PYTHONPATH="${DIFFUSIONDRIVE_BOOTSTRAP}:${H100_SUPPORT_DIR}:${ALGENGINE_ROOT}:${SIMENGINE_ROOT}:${DIFFUSIONDRIVE_ROOT}:${MMCV_ROOT}:${NUPLAN_DEVKIT_ROOT}:${SENIOR_NAVSIM_PARENT}:${SCRIPT_DIR}:${PYTHONPATH:-}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"

CONFIG="${ALGENGINE_ROOT}/configs/diffusiondrive/e2e_diffusiondrive_grpo_selector_v3_preaction_oracle.py"
SCENARIO_FILE="${SOURCE_WORLDENGINE_ROOT}/experiments/diffusiondrive/grpo_selector_v3_rare_clpdms_tuning_v1/closed_loop_split/development/all_scenarios.pkl"
SCENARIO_SHA256=6bdb15f638ea9843f0e69aa30a9ea732a1f9f3dd1351bdbe259ef180cb63a577
ASSET_ROOT="${SOURCE_WORLDENGINE_ROOT}/data/sim_engine/assets/navtest_failures/assets"
EXPERIMENT_ROOT="${WORLDENGINE_ROOT}/experiments/diffusiondrive/selector_oracle_r15"
RUN_ROOT="${EXPERIMENT_ROOT}/runs/${RUN_ID}"
TARGET_ROOT="${RUN_ROOT}/targets"
TARGET_MANIFEST="${TARGET_ROOT}/target_manifest.json"
REPEATABILITY_REPORT="${TARGET_ROOT}/reward_repeatability_diagnostic.json"
AUDITOR="${SCRIPT_DIR}/audit_selector_oracle_r15_collection.py"
BUILDER="${SCRIPT_DIR}/build_selector_oracle_r15_targets.py"
ANALYZER="${SCRIPT_DIR}/analyze_selector_oracle_r15.py"
REPEATABILITY_ANALYZER="${SCRIPT_DIR}/analyze_selector_oracle_r15_reward_repeatability.py"
SIM_TEST="${ALGENGINE_ROOT}/closed_loop/sim_test.py"
PLANNING_HEAD="${ALGENGINE_ROOT}/mmdet3d_plugin/navformer/dense_heads/diffusion_grpo_online_planning_head.py"
SCENE_SELECTOR="${ALGENGINE_ROOT}/mmdet3d_plugin/navformer/dense_heads/diffusion_grpo_scene_selector.py"
NAVFORMER="${ALGENGINE_ROOT}/mmdet3d_plugin/navformer/detectors/navformer.py"
NAVFORMER_CLIENT="${SIMENGINE_ROOT}/worldengine/components/agents/client/navformer_client.py"
PREACTION_MANAGER="${SIMENGINE_ROOT}/worldengine/manager/diffusiondrive_preaction_oracle_manager.py"
DYNAMIC_MANAGER="${SIMENGINE_ROOT}/worldengine/manager/diffusiondrive_dynamic_reward_manager.py"
BASE_ENV="${SIMENGINE_ROOT}/worldengine/envs/base_env.py"
DEFAULT_RUNNER="${SIMENGINE_ROOT}/worldengine/configs/default_runner.yaml"
MERGE_RESULTS="${SIMENGINE_ROOT}/scripts/merge_simulation_results.py"
R15_COMMON="${SCRIPT_DIR}/oracle_r15_common.py"

require_file() { [[ -f "$1" ]] || { echo "Missing required file: $1" >&2; exit 1; }; }
json_value() {
    "${ALGENGINE_PYTHON}" -c 'import json,sys; value=json.load(open(sys.argv[1]));
for key in sys.argv[2].split("."): value=value[key]
print(value)' "$1" "$2"
}
manifest_path() {
    echo "${SOURCE_WORLDENGINE_ROOT}/experiments/diffusiondrive/grpo_selector_v3_rare_original_v1/models/rare_tuned/seed${1}/checkpoint_manifest.json"
}
reference_audit() {
    local seed="$1" phase="$2" old_split
    case "${phase}" in
        baseline_smoke8) old_split=smoke8 ;;
        baseline_cl_dev58) old_split=cl_dev58 ;;
        *) return 2 ;;
    esac
    echo "${WORLDENGINE_ROOT}/experiments/diffusiondrive/selector_root_cause_r1/runs/implementation_20260902/${old_split}/scalar_v3/seed${seed}/collection_audit.json"
}

static_preflight() {
    local required=("${ALGENGINE_PYTHON}" "${SIMENGINE_PYTHON}" "${CONFIG}" "${SCENARIO_FILE}" "${AUDITOR}" "${BUILDER}" "${ANALYZER}" "${REPEATABILITY_ANALYZER}" "${SIM_TEST}" "${PLANNING_HEAD}" "${SCENE_SELECTOR}" "${NAVFORMER}" "${NAVFORMER_CLIENT}" "${PREACTION_MANAGER}" "${DYNAMIC_MANAGER}" "${BASE_ENV}" "${DEFAULT_RUNNER}" "${MERGE_RESULTS}" "${R15_COMMON}" "${WORLDENGINE_MMCV_EXTENSION}" "${WORLDENGINE_GSPLAT_EXTENSION}")
    local path
    for path in "${required[@]}"; do require_file "${path}"; done
    [[ -d "${ASSET_ROOT}" ]] || { echo "Missing asset root: ${ASSET_ROOT}" >&2; exit 1; }
    [[ "$(sha256sum "${SCENARIO_FILE}" | awk '{print $1}')" == "${SCENARIO_SHA256}" ]] || { echo "Development scenario SHA256 drifted" >&2; exit 1; }
    for seed in 0 1; do
        require_file "$(manifest_path "${seed}")"
        require_file "$(reference_audit "${seed}" baseline_smoke8)"
        require_file "$(reference_audit "${seed}" baseline_cl_dev58)"
    done
    mkdir -p "${RUN_ROOT}"
}

hopper_preflight() {
    "${ALGENGINE_PYTHON}" - <<'PY'
import json,torch
names=[torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())]
if len(names)!=8: raise RuntimeError(f"expected 8 visible GPUs, got {len(names)}")
if any(not any(x in name.upper() for x in ("H100","H200")) for name in names): raise RuntimeError(f"requires Hopper, got {names}")
if any(torch.cuda.get_device_capability(i)!=(9,0) for i in range(8)): raise RuntimeError("requires sm_90")
if str(torch.__version__)!="2.0.1+cu118" or torch.version.cuda!="11.8": raise RuntimeError(f"environment drift: {torch.__version__}/{torch.version.cuda}")
print(json.dumps({"status":"PASS","hardware_contract":"hopper8","devices":names,"torch":torch.__version__},sort_keys=True))
PY
    "${ALGENGINE_PYTHON}" "${H100_SUPPORT_DIR}/preflight_mmcv_cuda.py" --extension "${WORLDENGINE_MMCV_EXTENSION}" --expected-capability sm_90 --all-visible
    "${SIMENGINE_PYTHON}" "${H100_SUPPORT_DIR}/preflight_gsplat_cuda.py" --extension "${WORLDENGINE_GSPLAT_EXTENSION}" --expected-capability sm_90 --ray-workers 8
}

prepare_environment() {
    local seed="$1" phase="$2" mode="$3" target_sha="$4" manifest checkpoint
    manifest="$(manifest_path "${seed}")"
    checkpoint="$(json_value "${manifest}" checkpoint)"
    require_file "${checkpoint}"
    export DIFFUSIONDRIVE_BEHAVIOR_POLICY_TRAIN_SEED="${seed}"
    export DIFFUSIONDRIVE_ORACLE_R15_PHASE="${phase}"
    export DIFFUSIONDRIVE_ORACLE_R15_MODE="${mode}"
    export DIFFUSIONDRIVE_ORACLE_TARGET_MANIFEST_SHA256="${target_sha}"
    export DIFFUSIONDRIVE_BEHAVIOR_CHECKPOINT_SHA256="$(json_value "${manifest}" checkpoint_sha256)"
    export DIFFUSIONDRIVE_BEHAVIOR_CHECKPOINT_MANIFEST_SHA256="$(sha256sum "${manifest}" | awk '{print $1}')"
    [[ "$(sha256sum "${checkpoint}" | awk '{print $1}')" == "${DIFFUSIONDRIVE_BEHAVIOR_CHECKPOINT_SHA256}" ]] || { echo "Checkpoint SHA256 drifted" >&2; exit 1; }
    export DIFFUSIONDRIVE_ROLLOUT_NOISE_NAMESPACE=selector_root_cause_r1_evalnoise0
    export DIFFUSIONDRIVE_ROLLOUT_IMPLEMENTATION_SHA256="$({ sha256sum "${SIM_TEST}" "${NAVFORMER_CLIENT}" "${PREACTION_MANAGER}" "${DYNAMIC_MANAGER}" "${BASE_ENV}" "${DEFAULT_RUNNER}" "${R15_COMMON}"; } | sha256sum | awk '{print $1}')"
    export DIFFUSIONDRIVE_ROLLOUT_CODE_SHA="$({ sha256sum "${CONFIG}" "${SIM_TEST}" "${PLANNING_HEAD}" "${SCENE_SELECTOR}" "${NAVFORMER}" "${NAVFORMER_CLIENT}" "${PREACTION_MANAGER}" "${DYNAMIC_MANAGER}" "${BASE_ENV}" "${DEFAULT_RUNNER}" "${MERGE_RESULTS}" "${R15_COMMON}"; } | sha256sum | awk '{print $1}')"
    POLICY_MANIFEST="${manifest}"
    POLICY_CHECKPOINT="${checkpoint}"
}

verify_audit() {
    "${ALGENGINE_PYTHON}" -c 'import json,os,sys
r=json.load(open(sys.argv[1]))
assert r["status"]=="PASS" and r["method"]=="diffusiondrive_selector_oracle_r15_collection_audit_v1" and r["layout"]=="merged"
assert r["diagnostic_split"]==sys.argv[2] and r["oracle_intervention_mode"]==sys.argv[3]
assert r["behavior_policy_train_seed"]==int(sys.argv[4]) and r["target_manifest_sha256"]==sys.argv[5]
assert r["code_sha"]==os.environ["DIFFUSIONDRIVE_ROLLOUT_CODE_SHA"]
assert r["rollout_implementation_sha256"]==os.environ["DIFFUSIONDRIVE_ROLLOUT_IMPLEMENTATION_SHA256"]
assert r["closed_loop_outcome"] is not None' "$1" "$2" "$3" "$4" "$5"
}

verify_targets() {
    "${ALGENGINE_PYTHON}" -c 'import hashlib,json,pathlib,sys
def sha(path):
 d=hashlib.sha256()
 with open(path,"rb") as f:
  for chunk in iter(lambda:f.read(8*1024*1024),b""): d.update(chunk)
 return d.hexdigest()
p=pathlib.Path(sys.argv[1]).resolve(); r=json.load(open(p))
assert r["status"]=="PASS" and r["method"]=="diffusiondrive_selector_oracle_r15_targets_v1"
assert sha(r["source_scenario_file"])==r["source_scenario_file_sha256"]
for row in r["baseline_collections"]: assert sha(row["audit"])==row["audit_sha256"]
for row in r["collections"].values():
 assert sha(row["formal_scenario_file"])==row["formal_scenario_file_sha256"]
 assert sha(row["smoke_scenario_file"])==row["smoke_scenario_file_sha256"]' "${TARGET_MANIFEST}"
}

verify_repeatability() {
    "${ALGENGINE_PYTHON}" -c 'import hashlib,json,sys
def sha(path):
 d=hashlib.sha256()
 with open(path,"rb") as f:
  for chunk in iter(lambda:f.read(8*1024*1024),b""): d.update(chunk)
 return d.hexdigest()
r=json.load(open(sys.argv[1]))
assert r["status"]=="PASS" and r["method"]=="diffusiondrive_selector_oracle_r15_reward_repeatability_v1"
assert r["paired_scene_count"]==58 and r["decision_step"]==4
assert r["diagnosis"]=="PAIRWISE_PROGRESS_NORMALIZATION_NOT_REPEATABLE"
for row in r["baseline_audits"].values(): assert sha(row["path"])==row["sha256"]' "${REPEATABILITY_REPORT}"
}

run_reward_repeatability() {
    if [[ ! -f "${REPEATABILITY_REPORT}" ]]; then
        "${ALGENGINE_PYTHON}" "${REPEATABILITY_ANALYZER}" \
            --baseline-audit "${RUN_ROOT}/baseline_cl_dev58/observe_only/seed0/collection_audit.json" \
            --baseline-audit "${RUN_ROOT}/baseline_cl_dev58/observe_only/seed1/collection_audit.json" \
            --output "${REPEATABILITY_REPORT}"
    fi
    require_file "${REPEATABILITY_REPORT}"
    verify_repeatability
    echo "PASS R1.5 reward repeatability diagnosis: ${REPEATABILITY_REPORT}"
}

run_collection() {
    local seed="$1" phase="$2" mode="$3" scenario_file="$4" maximum="$5" target_manifest="${6:-}" reference="${7:-}"
    local target_sha=none
    if [[ -n "${target_manifest}" ]]; then require_file "${target_manifest}"; target_sha="$(sha256sum "${target_manifest}" | awk '{print $1}')"; fi
    prepare_environment "${seed}" "${phase}" "${mode}" "${target_sha}"
    local root="${RUN_ROOT}/${phase}/${mode}/seed${seed}"
    local final_audit="${root}/collection_audit.json"
    if [[ -f "${final_audit}" ]]; then verify_audit "${final_audit}" "${phase}" "${mode}" "${seed}" "${target_sha}"; echo "SKIP verified ${phase} ${mode} seed${seed}: ${final_audit}"; return 0; fi
    mkdir -p "${root}/logs"
    find "${root}" -name simulation_completed.flag -type f -delete
    local maximum_args=() maximum_audit=()
    if [[ "${maximum}" -gt 0 ]]; then maximum_args=("+max_successful_scenarios=${maximum}"); maximum_audit=(--maximum-scenarios "${maximum}"); fi
    local target_we_args=() target_audit_args=() reference_args=()
    if [[ -n "${target_manifest}" ]]; then
        target_we_args=(diffusiondrive_oracle_target_manifest="${target_manifest}" diffusiondrive_oracle_target_manifest_sha256="${target_sha}")
        target_audit_args=(--target-manifest "${target_manifest}")
    fi
    if [[ -n "${reference}" ]]; then require_file "${reference}"; reference_args=(--reference-r1-audit "${reference}"); fi

    "${ALGENGINE_PYTHON}" -c 'from mmcv import Config; import sys
c=Config.fromfile(sys.argv[1]); x=c.selector_rollout_contract
assert c.model.planning_head.export_rollout_context and c.model.planning_head.online_reward is None
assert x.schema_version==5 and x.action_score_timing=="pre_action" and x.oracle_intervention_mode==sys.argv[2]
assert x.oracle_intervention_treatment=="frozen_baseline_index_at_target_then_current_oracle"
assert x.target_reward_repeatability_role=="stability_sensitivity_not_treatment_identity"
assert x.causal_gate_requires_current_headroom_gt_0p02 is True' "${CONFIG}" "${mode}"

    local we_pid="" failure=0 planner_pids=()
    cleanup_collection() {
        trap - EXIT INT TERM
        local pid
        for pid in "${planner_pids[@]:-}"; do kill "${pid}" 2>/dev/null || true; done
        [[ -z "${we_pid}" ]] || kill "${we_pid}" 2>/dev/null || true
    }
    trap cleanup_collection EXIT INT TERM
    cd "${SIMENGINE_ROOT}"
    "${SIMENGINE_PYTHON}" worldengine/runner/run_simulation.py \
        debug_mode=True debug_scene_name=null data_file_path="${scenario_file}" asset_folder_path="${ASSET_ROOT}" \
        output_dir="${root}/__WORKER_ID__/WE_output" job_name="selector_r15_${phase}_${mode}_seed${seed}" \
        use_planner_actions=true ego_policy=env_input_policy ego_client=navformer_client ego_controller=log_play_controller ego_navigation=trajectory_navigation \
        agent_policy=idm_policy agent_navigation=idm_navigation planner_data_path="${root}/__WORKER_ID__/plan_traj" planner_client_folder="${root}/__WORKER_ID__/frames" \
        with_metric_manager=true with_dense_reward_manager=true diffusiondrive_preaction_oracle=true diffusiondrive_dynamic_candidate_reward=false \
        diffusiondrive_preaction_mode="${mode}" diffusiondrive_behavior_train_seed="${seed}" \
        diffusiondrive_candidate_sidecar_path="${root}/__WORKER_ID__/diffusiondrive_candidate_sidecars" diffusiondrive_sidecar_timeout_s=300 \
        distributed_mode=SCENARIO_BASED worker=ray_distributed worker_id_prefix=split_ enable_resume=true completed_scenarios_dir="${root}/__WORKER_ID__/completed_scenarios" \
        "${target_we_args[@]}" "${maximum_args[@]}" >"${root}/logs/worldengine.log" 2>&1 &
    we_pid=$!
    sleep 30
    run_planner() {
        local split_id="$1" worker_root="${root}/split_${1}"
        mkdir -p "${worker_root}/plan_traj" "${worker_root}/frames" "${worker_root}/merged_ann_files" "${worker_root}/diffusiondrive_candidate_sidecars"
        cd "${ALGENGINE_ROOT}"
        CUDA_VISIBLE_DEVICES="${split_id}" "${ALGENGINE_PYTHON}" closed_loop/sim_test.py "${CONFIG}" "${POLICY_CHECKPOINT}" --seed 0 --log-dir "${worker_root}" \
            --cfg-options sim.monitored_folder="${worker_root}/frames" sim.plan_save_path="${worker_root}/plan_traj" sim.merged_ann_save_dir="${worker_root}/merged_ann_files" \
            sim.diffusiondrive_rollout_sidecar_path="${worker_root}/diffusiondrive_candidate_sidecars" sim.clean_temp_files=False sim.clean_record_data=False data_root="${worker_root}/WE_output/openscene_format/" \
            >"${root}/logs/planner_split${split_id}.log" 2>&1
    }
    local split_id
    for split_id in 0 1 2 3 4 5 6 7; do run_planner "${split_id}" & planner_pids+=("$!"); done
    local pid
    for pid in "${planner_pids[@]}"; do wait "${pid}" || failure=1; done
    wait "${we_pid}" || failure=1
    we_pid=""; planner_pids=(); trap - EXIT INT TERM
    if [[ "${failure}" -ne 0 ]]; then
        echo "FAIL collection ${phase} ${mode} seed${seed}; rerun the same stage to resume" >&2
        tail -80 "${root}/logs/worldengine.log" >&2 || true
        exit 1
    fi

    local audit_common=(--rollout-root "${root}" --scenario-file "${scenario_file}" --checkpoint-manifest "${POLICY_MANIFEST}" --train-seed "${seed}" --phase "${phase}" --mode "${mode}" \
        --expected-noise-namespace "${DIFFUSIONDRIVE_ROLLOUT_NOISE_NAMESPACE}" --expected-implementation-sha256 "${DIFFUSIONDRIVE_ROLLOUT_IMPLEMENTATION_SHA256}" --expected-code-sha "${DIFFUSIONDRIVE_ROLLOUT_CODE_SHA}" --expected-workers 8 \
        "${maximum_audit[@]}" "${target_audit_args[@]}" "${reference_args[@]}")
    "${ALGENGINE_PYTHON}" "${AUDITOR}" "${audit_common[@]}" --layout split --output "${root}/premerge_collection_audit.json"
    cd "${SIMENGINE_ROOT}"
    "${SIMENGINE_PYTHON}" scripts/merge_simulation_results.py --test_path "${root}" --react_type R --num-splits 8
    local metrics="${root}/WE_output/openscene_format/all_scenes_pdm_averages_R.csv"
    require_file "${metrics}"
    "${ALGENGINE_PYTHON}" "${AUDITOR}" "${audit_common[@]}" --layout merged --metrics-csv "${metrics}" --output "${final_audit}"
    echo "PASS ${phase} ${mode} seed${seed}: ${final_audit}"
}

run_baselines() {
    local seed
    for seed in 0 1; do
        run_collection "${seed}" baseline_smoke8 observe_only "${SCENARIO_FILE}" 8 "" "$(reference_audit "${seed}" baseline_smoke8)"
        run_collection "${seed}" baseline_cl_dev58 observe_only "${SCENARIO_FILE}" -1 "" "$(reference_audit "${seed}" baseline_cl_dev58)"
    done
    if [[ ! -f "${TARGET_MANIFEST}" ]]; then
        mkdir -p "${TARGET_ROOT}"
        "${ALGENGINE_PYTHON}" "${BUILDER}" \
            --baseline-audit "${RUN_ROOT}/baseline_cl_dev58/observe_only/seed0/collection_audit.json" \
            --baseline-audit "${RUN_ROOT}/baseline_cl_dev58/observe_only/seed1/collection_audit.json" \
            --source-scenarios "${SCENARIO_FILE}" --output-root "${TARGET_ROOT}"
    fi
    require_file "${TARGET_MANIFEST}"
    verify_targets
    run_reward_repeatability
    echo "PASS frozen R1.5 targets: ${TARGET_MANIFEST}"
}

target_count() { json_value "${TARGET_MANIFEST}" "collections.${1}.target_count"; }
run_interventions() {
    require_file "${TARGET_MANIFEST}"
    verify_targets
    require_file "${REPEATABILITY_REPORT}"
    verify_repeatability
    local seed arm count smoke_file formal_file
    for seed in 0 1; do
        count="$(target_count "${seed}")"
        if [[ "${count}" -eq 0 ]]; then echo "SKIP seed${seed}: no eligible frozen target"; continue; fi
        smoke_file="$(json_value "${TARGET_MANIFEST}" "collections.${seed}.smoke_scenario_file")"
        formal_file="$(json_value "${TARGET_MANIFEST}" "collections.${seed}.formal_scenario_file")"
        for arm in one_shot_oracle persistent_oracle; do
            run_collection "${seed}" intervention_smoke8 "${arm}" "${smoke_file}" -1 "${TARGET_MANIFEST}" ""
            run_collection "${seed}" intervention_target8 "${arm}" "${formal_file}" -1 "${TARGET_MANIFEST}" ""
        done
    done
}

run_analysis() {
    require_file "${TARGET_MANIFEST}"
    verify_targets
    local output="${RUN_ROOT}/causal_gate.json"
    if [[ -f "${output}" ]]; then
        "${ALGENGINE_PYTHON}" -c 'import json,sys; r=json.load(open(sys.argv[1])); assert r["status"]=="PASS" and r["method"]=="diffusiondrive_selector_oracle_r15_causal_gate_v1"' "${output}"
        echo "SKIP verified causal gate: ${output}"
        return 0
    fi
    local args=(--target-manifest "${TARGET_MANIFEST}") seed count
    for seed in 0 1; do
        count="$(target_count "${seed}")"
        [[ "${count}" -gt 0 ]] || continue
        args+=(--baseline-audit "${RUN_ROOT}/baseline_cl_dev58/observe_only/seed${seed}/collection_audit.json")
        args+=(--one-shot-audit "${RUN_ROOT}/intervention_target8/one_shot_oracle/seed${seed}/collection_audit.json")
        args+=(--persistent-audit "${RUN_ROOT}/intervention_target8/persistent_oracle/seed${seed}/collection_audit.json")
    done
    "${ALGENGINE_PYTHON}" "${ANALYZER}" "${args[@]}" --bootstrap-repetitions 10000 --bootstrap-seed 20260902 --output "${output}"
    echo "PASS R1.5 causal gate: ${output}"
}

static_preflight
case "${MODE}" in
    preflight) hopper_preflight; echo "PASS selector oracle R1.5 preflight" ;;
    baseline) hopper_preflight; run_baselines ;;
    interventions) hopper_preflight; run_interventions ;;
    analyze) run_analysis ;;
    all) hopper_preflight; run_baselines; run_interventions; run_analysis ;;
esac
